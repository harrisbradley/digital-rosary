{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Digital Rosary Codebase Tour",
  "description": "A guided walkthrough of the app architecture, data flow, and reminders pipeline.",
  "steps": [
    {
      "title": "Start here: Product + feature map",
      "file": "README.md",
      "line": 1,
      "description": "Read this first for context. It summarizes user-facing capabilities: interactive rosary flow, mystery scheduling, prayer logging, streaks, auth, and reminders."
    },
    {
      "title": "Entrypoint + script wiring",
      "file": "index.html",
      "line": 48,
      "description": "This page bootstraps the app. Script order matters: Firebase SDKs load first, then firebase/auth/firestore services, then the main app logic (`js/app.js`)."
    },
    {
      "title": "Firebase configuration and global services",
      "file": "js/firebase-config.js",
      "line": 6,
      "description": "Firebase is initialized once and key services are exported to `window` (`firebaseAuth`, `firebaseDb`, `firebaseStorage`) for use by other modules."
    },
    {
      "title": "Auth service surface area",
      "file": "js/auth-service.js",
      "line": 28,
      "description": "Authentication logic is centralized here: email/password, Google sign-in, password reset/change, sign-out, and first-login localStorage migration."
    },
    {
      "title": "Firestore data model + helpers",
      "file": "js/firestore-service.js",
      "line": 148,
      "description": "This module defines app persistence operations: profile, settings, stats, prayer logs, notification tokens, and realtime listeners."
    },
    {
      "title": "Core prayer flow model (`GUIDE`)",
      "file": "js/app.js",
      "line": 265,
      "description": "The prayer experience is driven by a single ordered array (`GUIDE`): intro prayers, five decades generated by `createDecadeSteps`, and closing prayers."
    },
    {
      "title": "UI rendering pipeline",
      "file": "js/app.js",
      "line": 631,
      "description": "`renderStep()` translates `stepIndex` + `GUIDE` into UI: title, text, meditations, image loading, button state, and navigation affordances."
    },
    {
      "title": "Rosary logging + streak consistency",
      "file": "js/app.js",
      "line": 1692,
      "description": "`logRosary()` is the critical state transition. It prevents duplicate logs, computes streaks from prayer-log dates, writes remote/local stats, and updates the UI."
    },
    {
      "title": "Startup lifecycle",
      "file": "js/app.js",
      "line": 1998,
      "description": "Initialization sequence: apply settings, load/sync Firestore data if authenticated, hydrate UI, restore IRG progress, and attach auth-refresh hooks."
    },
    {
      "title": "Client-side web push integration",
      "file": "js/notification-service.js",
      "line": 171,
      "description": "Notification enrollment lives here: support checks, permission prompts, FCM token generation, Firestore token registration, and test notifications."
    },
    {
      "title": "Reminder sender job (server-side)",
      "file": "scripts/send-reminders.js",
      "line": 146,
      "description": "Scheduled Node job that evaluates user settings per timezone, determines due reminders, sends multicast push notifications, and prunes invalid tokens."
    },
    {
      "title": "Scheduler + ops docs",
      "file": ".github/workflows/send-prayer-reminders.yml",
      "line": 1,
      "description": "This workflow runs every 15 minutes and executes `scripts/send-reminders.js`. Pair it with `docs/NOTIFICATIONS_SETUP.md` for required secrets and setup."
    }
  ]
}
